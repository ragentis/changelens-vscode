{
  "name": "changelens",
  "displayName": "ChangeLens",
  "description": "Review changes made by AI agents or any external process, per hunk, independent of Git.",
  "version": "0.1.0",
  "publisher": "ragentis",
  "license": "MIT",
  "private": true,
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ragentis/changelens-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/ragentis/changelens-vscode/issues"
  },
  "homepage": "https://github.com/ragentis/changelens-vscode#readme",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ai coding",
    "ai agents",
    "agentic coding",
    "code review",
    "diff",
    "change tracking",
    "hunk review",
    "external changes",
    "accept changes",
    "revert changes",
    "gitless"
  ],
  "activationEvents": [
    "onFileSystem:changelens-base",
    "onFileSystem:changelens-current",
    "onFileSystem:changelens-review",
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "ChangeLens restores files over their current contents and runs Git in the workspace folder to follow branch changes, so it waits until the workspace is trusted."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "ChangeLens requires a file-backed workspace to track and restore changes."
    }
  },
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "changelens-typescript",
        "aliases": [
          "TypeScript (ChangeLens review)"
        ],
        "configuration": "./syntaxes/language-configuration.json"
      },
      {
        "id": "changelens-typescriptreact",
        "aliases": [
          "TypeScript JSX (ChangeLens review)"
        ],
        "configuration": "./syntaxes/language-configuration.json"
      },
      {
        "id": "changelens-javascript",
        "aliases": [
          "JavaScript (ChangeLens review)"
        ],
        "configuration": "./syntaxes/language-configuration.json"
      },
      {
        "id": "changelens-javascriptreact",
        "aliases": [
          "JavaScript JSX (ChangeLens review)"
        ],
        "configuration": "./syntaxes/language-configuration.json"
      },
      {
        "id": "changelens-json",
        "aliases": [
          "JSON (ChangeLens review)"
        ],
        "configuration": "./syntaxes/language-configuration.json"
      },
      {
        "id": "changelens-jsonc",
        "aliases": [
          "JSON with Comments (ChangeLens review)"
        ],
        "configuration": "./syntaxes/language-configuration.json"
      },
      {
        "id": "changelens-css",
        "aliases": [
          "CSS (ChangeLens review)"
        ],
        "configuration": "./syntaxes/language-configuration.json"
      },
      {
        "id": "changelens-scss",
        "aliases": [
          "SCSS (ChangeLens review)"
        ],
        "configuration": "./syntaxes/language-configuration.json"
      },
      {
        "id": "changelens-less",
        "aliases": [
          "Less (ChangeLens review)"
        ],
        "configuration": "./syntaxes/language-configuration.json"
      },
      {
        "id": "changelens-vue",
        "aliases": [
          "Vue (ChangeLens review)"
        ],
        "configuration": "./syntaxes/markup-language-configuration.json"
      },
      {
        "id": "changelens-mdx",
        "aliases": [
          "MDX (ChangeLens review)"
        ],
        "configuration": "./syntaxes/markup-language-configuration.json"
      },
      {
        "id": "changelens-yaml",
        "aliases": [
          "YAML (ChangeLens review)"
        ],
        "configuration": "./syntaxes/yaml-language-configuration.json"
      },
      {
        "id": "changelens-dockercompose",
        "aliases": [
          "Compose (ChangeLens review)"
        ],
        "configuration": "./syntaxes/yaml-language-configuration.json"
      },
      {
        "id": "changelens-github-actions-workflow",
        "aliases": [
          "GitHub Actions Workflow (ChangeLens review)"
        ],
        "configuration": "./syntaxes/yaml-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "changelens-typescript",
        "scopeName": "source.changelens.ts",
        "path": "./syntaxes/changelens-typescript.tmLanguage.json"
      },
      {
        "language": "changelens-typescriptreact",
        "scopeName": "source.changelens.tsx",
        "path": "./syntaxes/changelens-typescriptreact.tmLanguage.json"
      },
      {
        "language": "changelens-javascript",
        "scopeName": "source.changelens.js",
        "path": "./syntaxes/changelens-javascript.tmLanguage.json"
      },
      {
        "language": "changelens-javascriptreact",
        "scopeName": "source.changelens.js.jsx",
        "path": "./syntaxes/changelens-javascriptreact.tmLanguage.json"
      },
      {
        "language": "changelens-json",
        "scopeName": "source.changelens.json",
        "path": "./syntaxes/changelens-json.tmLanguage.json"
      },
      {
        "language": "changelens-jsonc",
        "scopeName": "source.changelens.json.comments",
        "path": "./syntaxes/changelens-jsonc.tmLanguage.json"
      },
      {
        "language": "changelens-css",
        "scopeName": "source.changelens.css",
        "path": "./syntaxes/changelens-css.tmLanguage.json"
      },
      {
        "language": "changelens-scss",
        "scopeName": "source.changelens.css.scss",
        "path": "./syntaxes/changelens-scss.tmLanguage.json"
      },
      {
        "language": "changelens-less",
        "scopeName": "source.changelens.css.less",
        "path": "./syntaxes/changelens-less.tmLanguage.json"
      },
      {
        "language": "changelens-vue",
        "scopeName": "text.html.changelens.vue",
        "path": "./syntaxes/changelens-vue.tmLanguage.json"
      },
      {
        "language": "changelens-mdx",
        "scopeName": "source.changelens.mdx",
        "path": "./syntaxes/changelens-mdx.tmLanguage.json"
      },
      {
        "language": "changelens-yaml",
        "scopeName": "source.changelens.yaml",
        "path": "./syntaxes/changelens-yaml.tmLanguage.json"
      },
      {
        "language": "changelens-dockercompose",
        "scopeName": "source.changelens.dockercompose",
        "path": "./syntaxes/changelens-dockercompose.tmLanguage.json"
      },
      {
        "language": "changelens-github-actions-workflow",
        "scopeName": "source.changelens.github-actions-workflow",
        "path": "./syntaxes/changelens-github-actions-workflow.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "changelens",
          "title": "ChangeLens",
          "icon": "assets/changelens.svg"
        }
      ]
    },
    "views": {
      "changelens": [
        {
          "id": "changelens.changes",
          "name": "Changes",
          "icon": "assets/changelens.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "changelens.changes",
        "when": "changelens.status == ready && !changelens.hasChanges",
        "contents": "No pending changes.\n\nEdits made by AI agents or other external tools will show up here for review."
      },
      {
        "view": "changelens.changes",
        "when": "!changelens.status || changelens.status == capturing",
        "contents": "Capturing workspace baseline…"
      },
      {
        "view": "changelens.changes",
        "when": "changelens.status == noFolder",
        "contents": "Open a folder to start reviewing changes.\n\nChangeLens compares a workspace against a baseline it captures, so it needs a folder on disk."
      },
      {
        "view": "changelens.changes",
        "when": "changelens.status == failed",
        "contents": "ChangeLens could not capture a baseline, so it is not tracking this window.\n\n[Reload Window](command:workbench.action.reloadWindow)"
      }
    ],
    "commands": [
      {
        "command": "changelens.refresh",
        "title": "Refresh",
        "category": "ChangeLens",
        "icon": "$(refresh)"
      },
      {
        "command": "changelens.openDiff",
        "title": "Open Change",
        "category": "ChangeLens"
      },
      {
        "command": "changelens.openFile",
        "title": "Open File",
        "category": "ChangeLens",
        "icon": "$(go-to-file)"
      },
      {
        "command": "changelens.acceptHunk",
        "title": "Accept Change",
        "category": "ChangeLens",
        "icon": "$(check)"
      },
      {
        "command": "changelens.revertHunk",
        "title": "Revert Change",
        "category": "ChangeLens",
        "icon": "$(discard)"
      },
      {
        "command": "changelens.acceptFile",
        "title": "Accept File",
        "category": "ChangeLens",
        "icon": "$(check)"
      },
      {
        "command": "changelens.revertFile",
        "title": "Revert File",
        "category": "ChangeLens",
        "icon": "$(discard)"
      },
      {
        "command": "changelens.acceptAll",
        "title": "Accept All",
        "category": "ChangeLens",
        "icon": "$(check-all)"
      },
      {
        "command": "changelens.revertAll",
        "title": "Revert All",
        "category": "ChangeLens",
        "icon": "$(discard)"
      },
      {
        "command": "changelens.viewAsList",
        "title": "Show as List",
        "category": "ChangeLens",
        "icon": "$(list-flat)"
      },
      {
        "command": "changelens.viewAsTree",
        "title": "Show as Tree",
        "category": "ChangeLens",
        "icon": "$(list-tree)"
      },
      {
        "command": "changelens.rebaseline",
        "title": "Reset Baseline to Current Workspace",
        "category": "ChangeLens"
      },
      {
        "command": "changelens.toggleReviewMode",
        "title": "Toggle Review Mode (Unified / Diff Editor)",
        "category": "ChangeLens"
      },
      {
        "command": "changelens.previousChange",
        "title": "Previous Change",
        "category": "ChangeLens",
        "icon": "$(arrow-up)"
      },
      {
        "command": "changelens.nextChange",
        "title": "Next Change",
        "category": "ChangeLens",
        "icon": "$(arrow-down)"
      },
      {
        "command": "changelens.acceptHunkAtCursor",
        "title": "Accept Block at Cursor",
        "category": "ChangeLens",
        "icon": "$(check)"
      },
      {
        "command": "changelens.revertHunkAtCursor",
        "title": "Revert Block at Cursor",
        "category": "ChangeLens",
        "icon": "$(discard)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "changelens.viewAsList",
          "when": "view == changelens.changes && changelens.status == ready && changelens.viewMode == tree",
          "group": "navigation@0"
        },
        {
          "command": "changelens.viewAsTree",
          "when": "view == changelens.changes && changelens.status == ready && changelens.viewMode == list",
          "group": "navigation@0"
        },
        {
          "command": "changelens.acceptAll",
          "when": "view == changelens.changes && changelens.status == ready",
          "group": "navigation@1"
        },
        {
          "command": "changelens.revertAll",
          "when": "view == changelens.changes && changelens.status == ready",
          "group": "navigation@2"
        },
        {
          "command": "changelens.refresh",
          "when": "view == changelens.changes && changelens.status == ready",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "changelens.openFile",
          "when": "view == changelens.changes && viewItem == changelens.file",
          "group": "inline@0"
        },
        {
          "command": "changelens.acceptFile",
          "when": "view == changelens.changes && viewItem == changelens.file",
          "group": "inline@1"
        },
        {
          "command": "changelens.revertFile",
          "when": "view == changelens.changes && viewItem == changelens.file",
          "group": "inline@2"
        }
      ],
      "editor/title": [
        {
          "command": "changelens.acceptHunkAtCursor",
          "when": "(resourceScheme == changelens-current || resourceScheme == changelens-review || resourceScheme == changelens-base) && changelens.activeFileHasHunks",
          "group": "navigation@0.1"
        },
        {
          "command": "changelens.revertHunkAtCursor",
          "when": "(resourceScheme == changelens-current || resourceScheme == changelens-review || resourceScheme == changelens-base) && changelens.activeFileHasHunks",
          "group": "navigation@0.2"
        },
        {
          "command": "changelens.previousChange",
          "when": "resourceScheme == changelens-review && changelens.activeFileHasHunks",
          "group": "navigation@0.3"
        },
        {
          "command": "changelens.nextChange",
          "when": "resourceScheme == changelens-review && changelens.activeFileHasHunks",
          "group": "navigation@0.4"
        },
        {
          "command": "changelens.openFile",
          "when": "resourceScheme == changelens-current || resourceScheme == changelens-review || resourceScheme == changelens-base",
          "group": "navigation@0.5"
        },
        {
          "command": "changelens.acceptFile",
          "when": "resourceScheme == changelens-current || resourceScheme == changelens-review || resourceScheme == changelens-base",
          "group": "1_changelens@1"
        },
        {
          "command": "changelens.revertFile",
          "when": "resourceScheme == changelens-current || resourceScheme == changelens-review || resourceScheme == changelens-base",
          "group": "1_changelens@2"
        },
        {
          "command": "changelens.acceptHunkAtCursor",
          "when": "resourceScheme == file && changelens.activeFileHasHunks",
          "group": "1_changelens@1"
        },
        {
          "command": "changelens.revertHunkAtCursor",
          "when": "resourceScheme == file && changelens.activeFileHasHunks",
          "group": "1_changelens@2"
        },
        {
          "command": "changelens.openDiff",
          "when": "resourceScheme == file && changelens.activeFileHasChanges",
          "group": "1_changelens@3"
        }
      ],
      "commandPalette": [
        {
          "command": "changelens.openDiff",
          "when": "false"
        },
        {
          "command": "changelens.acceptHunk",
          "when": "false"
        },
        {
          "command": "changelens.revertHunk",
          "when": "false"
        },
        {
          "command": "changelens.openFile",
          "when": "false"
        },
        {
          "command": "changelens.refresh",
          "when": "changelens.status == ready"
        },
        {
          "command": "changelens.acceptFile",
          "when": "changelens.status == ready"
        },
        {
          "command": "changelens.revertFile",
          "when": "changelens.status == ready"
        },
        {
          "command": "changelens.acceptAll",
          "when": "changelens.status == ready"
        },
        {
          "command": "changelens.revertAll",
          "when": "changelens.status == ready"
        },
        {
          "command": "changelens.acceptHunkAtCursor",
          "when": "changelens.status == ready"
        },
        {
          "command": "changelens.revertHunkAtCursor",
          "when": "changelens.status == ready"
        },
        {
          "command": "changelens.rebaseline",
          "when": "changelens.status == ready"
        },
        {
          "command": "changelens.toggleReviewMode",
          "when": "changelens.status == ready"
        },
        {
          "command": "changelens.previousChange",
          "when": "resourceScheme == changelens-review && changelens.activeFileHasHunks"
        },
        {
          "command": "changelens.nextChange",
          "when": "resourceScheme == changelens-review && changelens.activeFileHasHunks"
        },
        {
          "command": "changelens.viewAsList",
          "when": "changelens.status == ready && changelens.viewMode == tree"
        },
        {
          "command": "changelens.viewAsTree",
          "when": "changelens.status == ready && changelens.viewMode == list"
        }
      ]
    },
    "configuration": {
      "title": "ChangeLens",
      "properties": {
        "changelens.defaultReviewMode": {
          "type": "string",
          "enum": [
            "unified",
            "diffEditor"
          ],
          "enumDescriptions": [
            "Shows added and deleted lines inline in a single read-only editor.",
            "Uses VS Code's built-in diff editor."
          ],
          "default": "unified",
          "order": 1,
          "description": "How a pending file is opened for review until the Toggle Review Mode command is used. That toggle is remembered per workspace and takes precedence here."
        },
        "changelens.jumpToNextChange": {
          "type": "boolean",
          "default": true,
          "order": 2,
          "description": "Move the cursor to the next pending block after accepting or reverting one."
        },
        "changelens.defaultViewMode": {
          "type": "string",
          "enum": [
            "tree",
            "list"
          ],
          "enumDescriptions": [
            "Groups files under their folders.",
            "Shows every file in one flat list, with its folder in the description."
          ],
          "default": "tree",
          "order": 3,
          "description": "How the Changes view groups files until the view's own toggle is used. That toggle is remembered per workspace and takes precedence here."
        },
        "changelens.autoReveal": {
          "type": "boolean",
          "default": true,
          "order": 4,
          "description": "Select the active editor's file in the Changes view when it has pending changes."
        },
        "changelens.showCodeLensInEditor": {
          "type": "boolean",
          "default": true,
          "order": 5,
          "description": "Show Accept/Revert CodeLens above pending changes in the regular editor."
        },
        "changelens.decorateEditor": {
          "type": "boolean",
          "default": true,
          "order": 6,
          "description": "Highlight pending added lines in the regular editor."
        },
        "changelens.respectGitignore": {
          "type": "boolean",
          "default": true,
          "order": 7,
          "description": "Exclude files matched by the .gitignore in each workspace folder root. Nested .gitignore files are not read, and a rule cannot re-include a file inside an excluded folder."
        },
        "changelens.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.git/**",
            "**/node_modules/**",
            "**/dist/**",
            "**/out/**",
            "**/build/**",
            "**/*.lock",
            "**/package-lock.json"
          ],
          "order": 8,
          "description": "Additional glob patterns excluded from tracking."
        },
        "changelens.maxFileSizeKb": {
          "type": "number",
          "default": 512,
          "minimum": 1,
          "order": 9,
          "description": "Files larger than this are tracked at file level only, without content baselines."
        },
        "changelens.maxTrackedFiles": {
          "type": "number",
          "default": 20000,
          "minimum": 1,
          "order": 10,
          "description": "Shows a warning when the number of files in the baseline exceeds this threshold."
        }
      }
    },
    "resourceLabelFormatters": [
      {
        "scheme": "changelens-review",
        "formatting": {
          "label": "${path} (ChangeLens)",
          "separator": "/"
        }
      },
      {
        "scheme": "changelens-base",
        "formatting": {
          "label": "${path} (ChangeLens)",
          "separator": "/"
        }
      }
    ],
    "colors": [
      {
        "id": "changelens.addedResourceForeground",
        "description": "Color for files added by an external tool and awaiting review.",
        "defaults": {
          "dark": "gitDecoration.addedResourceForeground",
          "light": "gitDecoration.addedResourceForeground",
          "highContrast": "gitDecoration.addedResourceForeground",
          "highContrastLight": "gitDecoration.addedResourceForeground"
        }
      },
      {
        "id": "changelens.modifiedResourceForeground",
        "description": "Color for files modified by an external tool and awaiting review.",
        "defaults": {
          "dark": "gitDecoration.modifiedResourceForeground",
          "light": "gitDecoration.modifiedResourceForeground",
          "highContrast": "gitDecoration.modifiedResourceForeground",
          "highContrastLight": "gitDecoration.modifiedResourceForeground"
        }
      },
      {
        "id": "changelens.deletedResourceForeground",
        "description": "Color for files deleted by an external tool and awaiting review.",
        "defaults": {
          "dark": "gitDecoration.deletedResourceForeground",
          "light": "gitDecoration.deletedResourceForeground",
          "highContrast": "gitDecoration.deletedResourceForeground",
          "highContrastLight": "gitDecoration.deletedResourceForeground"
        }
      }
    ]
  },
  "scripts": {
    "clean": "rimraf --glob dist \"*.vsix\"",
    "bundle": "node scripts/build.mjs",
    "bundle:dev": "node scripts/build.mjs --dev",
    "bundle:watch": "node scripts/build.mjs --dev --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:bundle": "node scripts/audit-bundle.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "vscode:prepublish": "npm run bundle && npm run audit:bundle",
    "package:local": "npm run clean && vsce package",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "ovsx": "^1.1.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
