{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true
  },
  "ignorePatterns": ["dist"],
  "rules": {
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/require-await": "error",
    "typescript/restrict-plus-operands": "error",
    "eslint/eqeqeq": "error",
    "eslint/no-var": "error",
    // `model` and `storage` each publish a barrel; reaching past it into their internals couples
    // callers to collaborators that are meant to be reachable only through the facade.
    "eslint/no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/model/*", "**/storage/*"],
            "message": "Import from the folder barrel (\"../model\" or \"../storage\") instead of one of its internal files."
          }
        ]
      }
    ],
    "eslint/no-console": "error",
    // Preserve the established underscored private backing fields, including VS Code emitters.
    "eslint/no-underscore-dangle": "off",
    // Keep small helpers near their use sites.
    "unicorn/consistent-function-scoping": "off",
    // Both sort sites clone their inputs first, so neither mutates shared state.
    "unicorn/no-array-sort": "off"
  },
  "overrides": [
    {
      // Build scripts are untyped JavaScript and intentionally write CLI output.
      "files": ["scripts/**/*.mjs"],
      "rules": {
        "eslint/no-console": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off"
      }
    },
    {
      // Baseline, filesystem, and model mutations are intentionally sequential to preserve
      // state order and avoid unbounded I/O.
      "files": [
        "src/commands/index.ts",
        "src/model/baselineCapture.ts",
        "src/model/changeModel.ts",
        "src/model/fileEvents.ts",
        "src/model/reviewActions.ts",
        "src/storage/baselineStore.ts",
        "src/storage/blobStore.ts",
        "src/tracking/filter.ts"
      ],
      "rules": {
        "eslint/no-await-in-loop": "off"
      }
    },
    {
      // Unit tests exercise the internals a barrel deliberately hides, which is their job, and
      // they step through a scenario in order: running those steps in parallel would test
      // something else.
      "files": ["test/**/*.ts"],
      "rules": {
        "eslint/no-restricted-imports": "off",
        "eslint/no-await-in-loop": "off"
      }
    },
    {
      // The fake editor stands in for a module it cannot import, so the boundary between its
      // own classes and the vscode API types is asserted. Workspace edits apply in order.
      "files": ["test/helpers/vscode.ts"],
      "rules": {
        "eslint/no-await-in-loop": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    }
  ]
}
