{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Format",
      "type": "shell",
      "command": "npm run format",
      "options": {
        "statusbar": {
          "label": "Format",
          "detail": "Format the repository with Oxfmt"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Bundle watch",
      "type": "shell",
      "command": "npm run bundle:watch",
      "isBackground": true,
      "presentation": { "reveal": "never" },
      "options": {
        "statusbar": {
          "hide": true
        }
      },
      "problemMatcher": {
        "owner": "esbuild",
        "source": "esbuild",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+): (error|warning): (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[build\\] started$",
          "endsPattern": "^\\[build\\] finished$"
        }
      }
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "npm test",
      "group": "test",
      "options": {
        "statusbar": {
          "label": "Test",
          "detail": "Run the test suite"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Verify",
      "type": "shell",
      "command": "npm run verify",
      "options": {
        "statusbar": {
          "label": "Verify",
          "detail": "Run typecheck, lint, format check, and tests"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Build VSIX",
      "type": "shell",
      "command": "npm run package:local",
      "group": "build",
      "options": {
        "statusbar": {
          "label": "Build VSIX",
          "detail": "Build a local VSIX package"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Install VSIX",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-Command",
        "$vsix = Get-ChildItem -LiteralPath '${workspaceFolder}' -Filter 'changelens-*.vsix' -File | Sort-Object LastWriteTime -Descending | Select-Object -First 1; if (-not $vsix) { throw 'No local VSIX found. Run Build VSIX first.' }; $cli = Get-ChildItem -LiteralPath (Join-Path (Split-Path -Parent '${execPath}') 'bin') -Filter '*.cmd' -File | Select-Object -First 1; if (-not $cli) { throw 'VS Code CLI wrapper not found next to ${execPath}.' }; & $cli.FullName --install-extension $vsix.FullName --force"
      ],
      "options": {
        "statusbar": {
          "label": "Install VSIX",
          "detail": "Install the newest locally built VSIX"
        }
      },
      "problemMatcher": []
    }
  ]
}
